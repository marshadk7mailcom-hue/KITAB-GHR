<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#fcfaf6] p-5 max-w-3xl mx-auto">
<h1 class="text-3xl font-black mb-6">Your Cart</h1>
<div id="cart-items"></div>
<div class="bg-white p-6 rounded-2xl mt-6 border">
<p class="flex justify-between font-bold text-lg"><span>Total:</span> <span id="total">Rs. 0</span></p>
<input id="name" placeholder="Apna Naam" class="w-full border p-3 rounded-xl mt-4">
<input id="phone" placeholder="Phone Number" class="w-full border p-3 rounded-xl mt-3">
<input id="address" placeholder="Full Address" class="w-full border p-3 rounded-xl mt-3">
<button onclick="orderNow()" class="w-full mt-5 bg-[#25D366] text-white py-4 rounded-full font-bold">WhatsApp Par Order Bhejo</button>
<a href="/" class="block text-center mt-4 text-sm underline">Continue Shopping</a>
</div>
<script>
var cart = JSON.parse(localStorage.getItem('cart') || '[]');
var div = document.getElementById('cart-items');
var total = 0;
for (var i=0; i<cart.length; i++) {
  total = total + cart[i].price * cart[i].qty;
  div.innerHTML = div.innerHTML + "<div class='bg-white p-4 rounded-xl mb-3 flex justify-between'><span>" + cart[i].title + " x " + cart[i].qty + "</span><b>Rs." + cart[i].price*cart[i].qty + "</b></div>";
}
document.getElementById('total').innerText = 'Rs. ' + total;
function orderNow(){
 var name = document.getElementById('name').value;
 var phone = document.getElementById('phone').value;
 var address = document.getElementById('address').value;
 var city = document.getElementById('city').value;
 if(!name || !phone){ alert('Naam aur Phone likho'); return; }
 var msg = "NEW ORDER - KITAB GHR%0A%0AName: " + name + "%0APhone: " + phone + "%0AAddress: " + address + "%0ACity: " + city + "%0A%0A*Kitab List:*%0A";
 for(var j=0; j<cart.length; j++){ msg = msg + cart[j].title + " x " + cart[j].qty + " = Rs." + cart[j].price*cart[j].qty + "%0A"; }
 msg = msg + "%0A*Total: Rs." + total + "*";
 window.open("https://wa.me/923451406593?text=" + msg, "_blank");
 localStorage.removeItem('cart');
 window.location.href = '/thank-you';
}
</script>
</body>
</html>